# Copy this file to .env and adjust as needed.

# PostgreSQL connection string (see docker-compose.yml for local defaults)
DATABASE_URL=postgresql+psycopg://skillproof:skillproof@localhost:5432/skillproof

# Secret key for signing tokens (change to a long random value in production)
SECRET_KEY=change-me-in-production

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173